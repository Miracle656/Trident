---
import { Code } from 'astro:components';
import Landing from '../layouts/Landing.astro';
import GradientText from '../components/reactbits/GradientText';
import Squares from '../components/reactbits/Squares';
import { buttonVariants } from '../components/ui/button';
import {
  Archive,
  Braces,
  Container,
  Copy,
  Database,
  Filter,
  ListOrdered,
  Package,
  RadioTower,
  Search,
  Satellite,
} from 'lucide-react';

const sdkSnippet = `import { TridentClient } from '@trident-indexer/sdk';

const client = new TridentClient({ apiKey: process.env.TRIDENT_API_KEY });

// Every transfer this contract ever emitted — not just the last week.
for await (const event of client.iterEvents({
  contractId: 'CCFZQ7RWYQKPXENUFXLM3EJ4EPMWKXTLBFF3JMPWZDN6X2GDJVLKQ4XM',
  topic0: 'transfer',
})) {
  console.log(event.ledgerSequence, event.topics, event.data);
}`;

const capabilities = [
  {
    icon: Archive,
    title: 'Full historical storage',
    body: 'Events are kept permanently in Postgres, long after the RPC retention window has moved past them.',
  },
  {
    icon: Filter,
    title: 'Precise filtering',
    body: 'Query by contract, topic, event type, ledger range, or time — combined in a single request.',
  },
  {
    icon: ListOrdered,
    title: 'Cursor pagination',
    body: 'Stable cursors walk millions of events without missed or duplicated rows between pages.',
  },
  {
    icon: Braces,
    title: 'REST and GraphQL',
    body: 'The same indexed data behind both interfaces, with decoded XDR so you never parse it yourself.',
  },
  {
    icon: RadioTower,
    title: 'Real-time subscriptions',
    body: 'WebSocket and server-sent event streams push new contract events the moment they are indexed.',
  },
  {
    icon: Package,
    title: 'Typed SDKs',
    body: 'TypeScript, Go, Python, React, and Rust clients with auto-pagination and retry built in.',
  },
  {
    icon: Container,
    title: 'Self-hosted',
    body: 'One Docker Compose file runs the indexer, the APIs, Postgres, and Redis on your own hardware.',
  },
];

const ecosystem = [
  { chain: 'Ethereum', indexer: 'The Graph', current: false },
  { chain: 'Solana', indexer: 'Helius', current: false },
  { chain: 'Cosmos', indexer: 'SubQuery', current: false },
  { chain: 'Stellar', indexer: 'Trident', current: true },
];
---

<Landing
  title="Trident — the event indexer for Soroban"
  description="Trident indexes every Soroban smart-contract event on Stellar and keeps it queryable forever, through REST, GraphQL, and real-time streams."
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-white/10">
    <Squares client:load className="absolute inset-0 h-full w-full opacity-70" />
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(60% 50% at 50% 0%, rgba(255, 74, 31, 0.12) 0%, transparent 70%), radial-gradient(40% 35% at 80% 100%, rgba(47, 213, 117, 0.08) 0%, transparent 70%);"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-4xl px-4 py-24 text-center sm:px-6 sm:py-32">
      <p
        class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs text-white/70"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-signal-500" aria-hidden="true"></span>
        Indexing Stellar testnet right now
      </p>
      <h1 class="text-4xl font-semibold leading-tight tracking-tight text-white sm:text-6xl">
        Every Soroban event,<br />
        <GradientText>kept forever</GradientText>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-white/70 sm:text-lg">
        Trident watches Stellar, captures every smart-contract event, and keeps it queryable long
        after the network's own history window has moved on.
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href="/explorer" class={buttonVariants({ size: 'lg' })}>Open the explorer</a>
        <a
          href="https://docs.trident.dev"
          target="_blank"
          rel="noopener noreferrer"
          class={buttonVariants({ variant: 'outline', size: 'lg' })}
        >
          Read the docs
        </a>
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="mx-auto max-w-4xl px-4 py-20 sm:px-6" aria-labelledby="problem-heading">
    <h2 id="problem-heading" class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">
      The history window problem
    </h2>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-white/70">
      Stellar's RPC keeps a rolling window of recent ledgers — roughly a week of events — and then
      discards them. Ask about anything older and the answer is gone. So every team building on
      Soroban ends up writing the same thing: a poller, a decoder, a database, a backfill job, and
      an API in front of it all. Rebuilt, per project, before any product work starts.
    </p>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-white/70">
      Trident is that pipeline, built once and shared.
    </p>
  </section>

  <!-- Solution: ingest -> store -> query -->
  <section class="border-y border-white/10 bg-white/[0.02]" aria-labelledby="solution-heading">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h2 id="solution-heading" class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">
        How it works
      </h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-white/10 bg-black/40 p-6">
          <Satellite className="h-5 w-5 text-ember-500" aria-hidden="true" />
          <h3 class="mt-4 text-base font-medium text-white">Ingest</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/60">
            A Rust indexer follows the chain in real time, pulling every contract event from
            Soroban RPC and decoding the XDR as it lands.
          </p>
        </div>
        <div class="rounded-xl border border-white/10 bg-black/40 p-6">
          <Database className="h-5 w-5 text-ember-500" aria-hidden="true" />
          <h3 class="mt-4 text-base font-medium text-white">Store</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/60">
            Events land in partitioned Postgres with their topics, data, and transaction context —
            deduplicated, ordered, and kept permanently.
          </p>
        </div>
        <div class="rounded-xl border border-white/10 bg-black/40 p-6">
          <Search className="h-5 w-5 text-ember-500" aria-hidden="true" />
          <h3 class="mt-4 text-base font-medium text-white">Query</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/60">
            REST, GraphQL, and live streams serve the indexed history — filtered, paginated, and
            already decoded into JSON.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Ecosystem comparison -->
  <section class="mx-auto max-w-4xl px-4 py-20 sm:px-6" aria-labelledby="ecosystem-heading">
    <h2 id="ecosystem-heading" class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">
      Every ecosystem has one
    </h2>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-white/70">
      Serious smart-contract platforms grow a canonical event indexer. Stellar's was missing.
    </p>
    <div class="mt-8 overflow-x-auto rounded-xl border border-white/10">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b border-white/10 text-white/50">
            <th scope="col" class="px-5 py-3 font-medium">Network</th>
            <th scope="col" class="px-5 py-3 font-medium">Event indexer</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/10">
          {
            ecosystem.map((row) => (
              <tr class={row.current ? 'bg-ember-600/10' : undefined}>
                <td class="px-5 py-3.5 text-white/70">{row.chain}</td>
                <td class="px-5 py-3.5">
                  {row.current ? (
                    <span class="inline-flex items-center gap-2 font-medium text-white">
                      Trident
                      <span class="rounded-full border border-signal-600/40 bg-signal-600/10 px-2 py-0.5 text-xs font-normal text-signal-400">
                        here
                      </span>
                    </span>
                  ) : (
                    <span class="text-white/70">{row.indexer}</span>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="border-y border-white/10 bg-white/[0.02]" aria-labelledby="capabilities-heading">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h2
        id="capabilities-heading"
        class="text-2xl font-semibold tracking-tight text-white sm:text-3xl"
      >
        What you get
      </h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          capabilities.map((cap) => (
            <div class="rounded-xl border border-white/10 bg-black/40 p-6">
              <cap.icon className="h-5 w-5 text-ember-500" aria-hidden="true" />
              <h3 class="mt-4 text-base font-medium text-white">{cap.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/60">{cap.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Code sample -->
  <section class="mx-auto max-w-4xl px-4 py-20 sm:px-6" aria-labelledby="code-heading">
    <h2 id="code-heading" class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">
      Ten lines to the full history
    </h2>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-white/70">
      The TypeScript SDK paginates for you. Ask for a contract's events and iterate — Trident walks
      the cursor until there is nothing left to return.
    </p>
    <div class="relative mt-8 overflow-hidden rounded-xl border border-white/10">
      <button
        id="copy-snippet"
        type="button"
        class="absolute right-3 top-3 z-10 inline-flex items-center gap-1.5 rounded-md border border-white/10 bg-black/60 px-2.5 py-1.5 text-xs text-white/70 transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ember-400"
        data-snippet={sdkSnippet}
      >
        <Copy className="h-3.5 w-3.5" aria-hidden="true" />
        <span>Copy</span>
      </button>
      <Code
        code={sdkSnippet}
        lang="ts"
        theme="github-dark-default"
        class="!m-0 overflow-x-auto !bg-[#0a0a0a] p-5 text-sm leading-relaxed"
      />
    </div>
  </section>
</Landing>

<script>
  const btn = document.getElementById('copy-snippet') as HTMLButtonElement | null;
  const label = btn?.querySelector('span') ?? null;
  if (btn) {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.snippet ?? '');
        if (label) label.textContent = 'Copied';
        setTimeout(() => {
          if (label) label.textContent = 'Copy';
        }, 1500);
      } catch {
        /* clipboard unavailable */
      }
    });
  }
</script>
