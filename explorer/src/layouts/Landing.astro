---
import '../styles/landing.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth bg-black text-white">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Trident" />
  </head>
  <body class="min-h-full flex flex-col bg-black antialiased">
    <header class="sticky top-0 z-20 border-b border-white/10 bg-black/80 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5 sm:px-6">
        <a href="/" class="text-lg font-semibold tracking-tight text-white">Trident</a>
        <nav class="flex items-center gap-5 text-sm text-white/70" aria-label="Main">
          <a href="/explorer" class="transition-colors hover:text-white">Explorer</a>
          <a href="/status" class="transition-colors hover:text-white">Status</a>
          <a
            href="https://docs.trident.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden transition-colors hover:text-white sm:block">Docs</a
          >
          <a
            href="https://github.com/Telocel-Labs/Trident"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden transition-colors hover:text-white sm:block">GitHub</a
          >
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-white/10">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-2 sm:px-6 lg:grid-cols-4">
        <div>
          <p class="text-base font-semibold text-white">Trident</p>
          <p class="mt-2 max-w-xs text-sm leading-relaxed text-white/55">
            The event indexer for Soroban. Every contract event on Stellar, kept and queryable.
          </p>
        </div>
        <nav aria-label="Product">
          <h2 class="text-sm font-medium text-white">Product</h2>
          <ul class="mt-3 space-y-2 text-sm text-white/55">
            <li><a href="/explorer" class="transition-colors hover:text-white">Explorer</a></li>
            <li><a href="/status" class="transition-colors hover:text-white">Status</a></li>
            <li>
              <a
                href="https://app.trident.dev/signup"
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors hover:text-white">Get an API key</a
              >
            </li>
          </ul>
        </nav>
        <nav aria-label="Developers">
          <h2 class="text-sm font-medium text-white">Developers</h2>
          <ul class="mt-3 space-y-2 text-sm text-white/55">
            <li>
              <a
                href="https://docs.trident.dev"
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors hover:text-white">Documentation</a
              >
            </li>
            <li>
              <a
                href="https://github.com/Telocel-Labs/Trident"
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors hover:text-white">GitHub</a
              >
            </li>
            <li>
              <a
                href="https://www.npmjs.com/package/@trident-indexer/sdk"
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors hover:text-white">TypeScript SDK</a
              >
            </li>
          </ul>
        </nav>
        <div>
          <h2 class="text-sm font-medium text-white">Network</h2>
          <p class="mt-3 flex items-center gap-2 text-sm text-white/55">
            <span class="h-2 w-2 rounded-full bg-signal-500" aria-hidden="true"></span>
            Indexing Stellar testnet
          </p>
        </div>
      </div>
      <div class="border-t border-white/10 px-4 py-4 text-center text-xs text-white/50">
        Trident — Soroban event indexer for Stellar
      </div>
    </footer>
  </body>
</html>
